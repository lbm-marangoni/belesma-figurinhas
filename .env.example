# Copie para .env.local. .env.local NUNCA e comitado.
#
# Estas duas sao PUBLICAS por design: vao no bundle do navegador de qualquer
# jeito. Quem protege o acervo e a RLS, nao o segredo da chave.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NAO existe admin key neste projeto. A permissao administrativa e
# players.is_admin, ligada na mao pelo painel do Supabase e checada dentro de
# cada RPC. Se um dia aparecer uma admin key aqui, e bug (spec secao 18).
